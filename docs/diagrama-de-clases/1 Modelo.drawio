  <diagram name="Página-1" id="5I7faap3-8J_pK8l-xow">
    <mxGraphModel dx="2943" dy="1643" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Paciente {\n        +int CARACTERES_IDENTIFICACION$\n        -String identificacion\n        -String nombres\n        -String apellidos\n        -LocalDate fechaNacimiento\n        -Sexo sexo\n        -String telefono\n        -String correo\n        -TipoSangre tipoSangre\n        +getIdentificacion() String\n        +getNombreCompleto() String\n        +getFechaNacimientoFormateada() String\n        +getEdad() int\n        +getSexo() Sexo\n        +getTipoSangre() TipoSangre\n    }\n\n    class Medico {\n        -UUID uuid\n        -String nombres\n        -String apellidos\n        -String especialidad\n        -String telefono\n        -String correo\n        -LocalTime horaInicio\n        -LocalTime horaFin\n        -boolean activo\n        +getUuid() UUID\n        +getNombreCompleto() String\n        +getHorarioFormateado() String\n        +getEstadoTexto() String\n        +getUuidCorto() String\n        +isActivo() boolean\n    }\n\n    class Cita {\n        +int DURACION_MINUTOS$\n        -UUID uuid\n        -String identificacionPaciente\n        -UUID uuidMedico\n        -LocalDate fecha\n        -LocalTime horaInicio\n        -String motivo\n        -EstadoCita estado\n        -String observaciones\n        +getHoraFin() LocalTime\n        +getHorarioFormateado() String\n        +seSolapaCon(Cita otra) boolean\n        +getUuidCorto() String\n    }\n\n    class Especialidad {\n        -String nombre\n        +getNombre() String\n    }\n\n    class RegistroLog {\n        -String usuario\n        -LocalDateTime marcaTiempo\n        -Modulo modulo\n        -Accion accion\n        -String detalle\n        +getMarcaTiempoFormateada() String\n    }\n\n    class Reporte {\n        -String titulo\n        -List~String~ columnas\n        -List~ListaDeString~ filas\n        +agregarFila(String... celdas) void\n        +getColumnas() List~String~\n        +getFilas() List~ListaDeString~\n        +cantidadFilas() int\n    }\n\n    class Sexo {\n        &lt;&lt;enumeration&gt;&gt;\n        MASCULINO\n        FEMENINO\n    }\n\n    class TipoSangre {\n        &lt;&lt;enumeration&gt;&gt;\n        A_POSITIVO\n        A_NEGATIVO\n        B_POSITIVO\n        B_NEGATIVO\n        AB_POSITIVO\n        AB_NEGATIVO\n        O_POSITIVO\n        O_NEGATIVO\n        +getEtiqueta() String\n    }\n\n    class EstadoCita {\n        &lt;&lt;enumeration&gt;&gt;\n        PROGRAMADA\n        ATENDIDA\n        CANCELADA\n        +getDescripcion() String\n    }\n\n    class Modulo {\n        &lt;&lt;enumeration&gt;&gt;\n        PACIENTES\n        MEDICOS\n        CITAS\n        REPORTES\n        SISTEMA\n    }\n\n    class Accion {\n        &lt;&lt;enumeration&gt;&gt;\n        CREACION\n        CONSULTA\n        ACTUALIZACION\n        ELIMINACION\n        EXPORTACION\n        ERROR\n    }\n\n    Paciente --&gt; Sexo\n    Paciente --&gt; TipoSangre\n    Cita --&gt; EstadoCita\n    RegistroLog --&gt; Modulo\n    RegistroLog --&gt; Accion\n\n    Cita ..&gt; Paciente : referencia por DPI\n    Cita ..&gt; Medico : referencia por UUID\n    Medico ..&gt; Especialidad : referencia por nombre&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="n0_mJHNSA3_PfHHloOhF-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
