        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class ArchivoBase~T~ {\n        &lt;&lt;abstract&gt;&gt;\n        #escribirDatos(T entidad, BufferRegistro buffer)* void\n        #leerDatos(BufferRegistro buffer)* T\n        #alIndexar(long posicion, T entidad) void\n        #insertar(T entidad) long\n        #actualizar(long posicion, T entidad) void\n        #eliminarLogico(long posicion) void\n        #leerPorPosicion(long posicion) Optional~T~\n        +listarTodos() List~T~\n        +recorrer(RecorridoRegistro~T~ accion) void\n        +contar() int\n        +tamanioRegistro() int\n        +close() void\n    }\n\n    class ArchivoPacientes {\n        -Map~String,Long~ indicePorIdentificacion\n        +agregar(Paciente p) void\n        +buscarPorIdentificacion(String id) Optional~Paciente~\n        +modificar(Paciente p) void\n        +eliminar(String id) void\n        +existe(String id) boolean\n    }\n\n    class ArchivoMedicos {\n        -Map~UUID,Long~ indicePorUuid\n        +agregar(Medico m) UUID\n        +buscarPorUuid(UUID uuid) Optional~Medico~\n        +modificar(Medico m) void\n        +eliminar(UUID uuid) void\n        +existe(UUID uuid) boolean\n    }\n\n    class ArchivoCitas {\n        -Map~UUID,Long~ indicePorUuid\n        +agregar(Cita c) UUID\n        +buscarPorUuid(UUID uuid) Optional~Cita~\n        +modificar(Cita c) void\n        +eliminar(UUID uuid) void\n        +listarPorPaciente(String dpi) List~Cita~\n        +listarPorMedico(UUID uuid) List~Cita~\n        +listarPorFecha(LocalDate f) List~Cita~\n        +listarPorEstado(EstadoCita e) List~Cita~\n        +pacienteTieneCitasProgramadas(String dpi) boolean\n        +medicoTieneCitasProgramadas(UUID uuid) boolean\n    }\n\n    class ArchivoEspecialidades {\n        -Map~String,Long~ indicePorNombre\n        +agregar(Especialidad e) void\n        +existe(String nombre) boolean\n        +cantidad() int\n    }\n\n    class ArchivoLogs {\n        +agregar(RegistroLog log) void\n    }\n\n    class BufferRegistro {\n        +escribirCadena(String v, int n) void\n        +leerCadena(int n) String\n        +escribirUUID(UUID v) void\n        +leerUUID() UUID\n        +escribirFecha(LocalDate v) void\n        +leerFecha() LocalDate\n        +escribirEnum(Enum v) void\n        +bytesDeCadena(int n)$ int\n    }\n\n    ArchivoBase &lt;|-- ArchivoPacientes\n    ArchivoBase &lt;|-- ArchivoMedicos\n    ArchivoBase &lt;|-- ArchivoCitas\n    ArchivoBase &lt;|-- ArchivoEspecialidades\n    ArchivoBase &lt;|-- ArchivoLogs\n    ArchivoBase ..&gt; BufferRegistro : usa para serializar&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IGacFlejpf5vNVxrj-cR-1">
