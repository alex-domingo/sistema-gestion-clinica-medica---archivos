        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class PacienteServicio {\n        -ArchivoPacientes archivo\n        -ArchivoCitas archivoCitas\n        -LogServicio log\n        +registrar(Paciente p) void\n        +modificar(Paciente p) void\n        +eliminar(String id) void\n        +buscarPorIdentificacion(String id) Paciente\n        +existe(String id) boolean\n        +listarTodos() List~Paciente~\n        +buscar(String texto) List~Paciente~\n    }\n\n    class MedicoServicio {\n        -ArchivoMedicos archivo\n        -EspecialidadServicio especialidades\n        -ArchivoCitas archivoCitas\n        -LogServicio log\n        +registrar(Medico m) UUID\n        +modificar(Medico m) void\n        +cambiarEstado(UUID uuid, boolean activo) void\n        +eliminar(UUID uuid) void\n        +buscarPorUuid(UUID uuid) Medico\n        +buscarSiExiste(UUID uuid) Medico\n        +listarActivos() List~Medico~\n        +listarInactivos() List~Medico~\n        +listarPorEspecialidad(String esp) List~Medico~\n        +buscar(String texto) List~Medico~\n        +parsearHora(String texto)$ LocalTime\n    }\n\n    class CitaServicio {\n        -ArchivoCitas archivo\n        -PacienteServicio pacientes\n        -MedicoServicio medicos\n        -LogServicio log\n        +programar(Cita c) UUID\n        +cancelar(UUID uuid) void\n        +marcarAtendida(UUID uuid) void\n        +modificarMotivoObservaciones(UUID uuid, String motivo, String obs) void\n        +eliminar(UUID uuid) void\n        +listarPorPaciente(String dpi) List~Cita~\n        +listarPorMedico(UUID uuid) List~Cita~\n        +listarPorFecha(LocalDate f) List~Cita~\n        +listarPorEstado(EstadoCita e) List~Cita~\n        +listarPorRangoFechas(LocalDate d, LocalDate h) List~Cita~\n        +buscar(String texto) List~Cita~\n    }\n\n    class EspecialidadServicio {\n        -ArchivoEspecialidades archivo\n        -LogServicio log\n        +agregar(String nombre) void\n        +listarTodas() List~Especialidad~\n        +existe(String nombre) boolean\n    }\n\n    class LogServicio {\n        -ArchivoLogs archivo\n        +registrar(Modulo m, Accion a, String detalle) void\n        +listarTodos() List~RegistroLog~\n        +listarPorModulo(Modulo m) List~RegistroLog~\n        +listarPorAccion(Accion a) List~RegistroLog~\n        +listarPorRangoFechas(LocalDate d, LocalDate h) List~RegistroLog~\n    }\n\n    class ReporteServicio {\n        -PacienteServicio pacientes\n        -MedicoServicio medicos\n        -CitaServicio citas\n        -LogServicio logs\n        +pacientesCompleto() Reporte\n        +pacientesPorTipoSangre(TipoSangre t) Reporte\n        +pacientesMayorCitas() Reporte\n        +pacientesSinCitas() Reporte\n        +medicosCompleto() Reporte\n        +medicosPorEspecialidad(String esp) Reporte\n        +medicosMayorCitas() Reporte\n        +medicosConCitasEnFecha(LocalDate f) Reporte\n        +citasCompleto() Reporte\n        +citasPorRango(LocalDate d, LocalDate h) Reporte\n        +citasPorMedico(UUID uuid) Reporte\n        +citasPorPaciente(String dpi) Reporte\n        +citasPorEstado(EstadoCita e) Reporte\n        +cantidadCitasPorEspecialidad() Reporte\n        +logsCompleto() Reporte\n    }\n\n    CitaServicio --&gt; PacienteServicio\n    CitaServicio --&gt; MedicoServicio\n    MedicoServicio --&gt; EspecialidadServicio\n    ReporteServicio --&gt; PacienteServicio\n    ReporteServicio --&gt; MedicoServicio\n    ReporteServicio --&gt; CitaServicio\n    ReporteServicio --&gt; LogServicio\n    PacienteServicio ..&gt; LogServicio\n    MedicoServicio ..&gt; LogServicio\n    CitaServicio ..&gt; LogServicio&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jQFftBLTYKqfHoxOjVQi-1">
